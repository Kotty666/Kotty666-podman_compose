{
  "name": "Kotty666-podman_compose",
  "version": "1.0.7",
  "author": "Kotty666",
  "summary": "Manage podman-compose projects via Hiera-driven compose files and systemd services",
  "license": "Apache-2.0",
  "source": "https://github.com/Kotty666/Kotty666-podman_compose",
  "project_page": "https://github.com/Kotty666/Kotty666-podman_compose",
  "issues_url": "https://github.com/Kotty666/Kotty666-podman_compose/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "data_provider": "hiera",
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04",
        "26.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "podman",
    "compose",
    "container",
    "systemd",
    "rootless"
  ]
}
