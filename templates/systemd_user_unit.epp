<%- |
  String                $project_name,
  Stdlib::Absolutepath  $compose_dir,
  Stdlib::Absolutepath  $compose_binary,
  String                $compose_file_name,
  Boolean               $pull_on_start,
  Integer               $service_timeout,
  Hash[String, String]  $extra_systemd_config,
  Hash[String, String]  $proxy_env,
  Hash[String, Integer] $scale,
| -%>
<%- $scale_args = empty($scale) ? { true => '', default => ' ' + $scale.map |$svc, $n| { "--scale ${svc}=${n}" }.join(' ') } -%>
# Managed by Puppet - DO NOT EDIT
# podman-compose project: <%= $project_name %> (rootless)

[Unit]
Description=Podman Compose Project - <%= $project_name %>
Documentation=man:podman-compose(1)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=<%= $compose_dir %>
<% $proxy_env.each |String $key, String $value| { -%>
Environment="<%= $key %>=<%= $value %>"
<% } -%>
<% if $pull_on_start { -%>
ExecStartPre=<%= $compose_binary %> -f <%= $compose_file_name %> pull
<% } -%>
ExecStart=<%= $compose_binary %> -f <%= $compose_file_name %> up -d --remove-orphans<%= $scale_args %>
ExecStop=<%= $compose_binary %> -f <%= $compose_file_name %> down
ExecReload=<%= $compose_binary %> -f <%= $compose_file_name %> up -d --remove-orphans<%= $scale_args %>
TimeoutStartSec=<%= $service_timeout %>
Restart=on-failure
RestartSec=30
<% $extra_systemd_config.each |String $key, String $value| { -%>
<%= $key %>=<%= $value %>
<% } -%>

[Install]
WantedBy=default.target
