<%- |
  Stdlib::Absolutepath $compose_binary,
  String               $compose_file_name,
  String               $recreate_ops,
| -%>
#!/bin/bash
# Managed by Puppet — DO NOT EDIT
#
# Compares the running image digest of each compose service against the
# desired image (after a quiet `pull`).
#
# Usage:
#   .puppet-verify-images.sh check    # exit 0 = in sync, 1 = drift
#   .puppet-verify-images.sh update   # bring services in sync via `up -d`
#
# `check` is wired up as the `unless` of a Puppet exec, `update` as its
# `command` — so Puppet only reports a change when drift is actually fixed.

set -uo pipefail

ACTION="${1:-check}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

COMPOSE_BIN="<%= $compose_binary %>"
COMPOSE_FILE="<%= $compose_file_name %>"
IMAGES_FILE="$SCRIPT_DIR/.puppet-images.txt"

[ -f "$IMAGES_FILE" ] || exit 0

# Without the compose file there is nothing to verify (e.g. the file has not
# been written yet, or the project is being torn down). Report "no drift" so
# the check stays quiet instead of letting podman-compose abort with
# "missing files".
[ -f "$SCRIPT_DIR/$COMPOSE_FILE" ] || exit 0

# Refresh local images so digests reflect what the registry currently serves.
# Failures (offline, auth, …) must not break the run — drift will still be
# reported correctly based on whatever is locally available.
"$COMPOSE_BIN" -f "$COMPOSE_FILE" pull >/dev/null 2>&1 || true

drift=0

# Resolve the Compose project name following the same precedence as Compose:
# 1. COMPOSE_PROJECT_NAME env var
# 2. top-level `name:` in the compose file
# 3. COMPOSE_PROJECT_NAME= in the .env file
# 4. directory basename, lowercased (Compose spec mandates lowercase)
_compose_project_name() {
  [ -n "${COMPOSE_PROJECT_NAME:-}" ] && { echo "$COMPOSE_PROJECT_NAME"; return; }
  local n
  n=$(grep -m1 '^name:' "$SCRIPT_DIR/$COMPOSE_FILE" 2>/dev/null \
      | sed 's/^name:[[:space:]]*//' | tr -d "\"'" | xargs || true)
  [ -n "$n" ] && { echo "$n"; return; }
  if [ -f "$SCRIPT_DIR/.env" ]; then
    n=$(grep -m1 '^COMPOSE_PROJECT_NAME=' "$SCRIPT_DIR/.env" 2>/dev/null \
        | cut -d= -f2- | tr -d "\"'" | xargs || true)
    [ -n "$n" ] && { echo "$n"; return; }
  fi
  basename "$SCRIPT_DIR" | tr '[:upper:]' '[:lower:]'
}
PROJECT="$(_compose_project_name)"

while IFS=$'\t' read -r svc image; do
  [ -z "${svc:-}" ] && continue
  [ -z "${image:-}" ] && continue

  # Look up the running container via Docker-compatibility labels
  # (com.docker.compose.*), which podman-compose has set since v1.0 and are
  # present on all supported distro packages. The io.podman.compose.* labels
  # were only added in v1.5.0 and are absent on e.g. Ubuntu 24.04 (v1.0.6).
  # Fall back to io.podman.compose.* for any future-only installs.
  cid=$(podman ps \
    --filter "label=com.docker.compose.project=${PROJECT}" \
    --filter "label=com.docker.compose.service=${svc}" \
    --format '{{.ID}}' 2>/dev/null | head -n1 || true)
  if [ -z "$cid" ]; then
    cid=$(podman ps \
      --filter "label=io.podman.compose.project=${PROJECT}" \
      --filter "label=io.podman.compose.service=${svc}" \
      --format '{{.ID}}' 2>/dev/null | head -n1 || true)
  fi
  if [ -z "$cid" ]; then
    drift=1
    continue
  fi

  # Resolve both sides to their sha256 digest via `image inspect` so the
  # comparison is always digest-vs-digest. `container inspect .Image` returns
  # the image name/tag (not a digest), so comparing it directly against
  # `image inspect .Id` always fails. Resolving through image inspect handles
  # both the name and the short-ID cases uniformly.
  running_ref=$(podman inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)
  running=$(podman image inspect "$running_ref" --format '{{.Id}}' 2>/dev/null || true)
  desired=$(podman image inspect "$image" --format '{{.Id}}' 2>/dev/null || true)

  running="${running#sha256:}"
  desired="${desired#sha256:}"

  if [ -z "$desired" ] || [ -z "$running" ] || [ "$running" != "$desired" ]; then
    drift=1
  fi
done < "$IMAGES_FILE"

if [ "$ACTION" = "check" ]; then
  exit "$drift"
fi

if [ "$drift" -eq 1 ]; then
  # Bring the drifted services back in sync using the same recreate strategy
  # as the compose/.env change trigger. A bare `up -d` does NOT recreate a
  # running container when only the image digest behind a stable tag (e.g.
  # `:latest`) changed — podman-compose treats the service as "already up".
  # The strategy default (`force-recreate`) ensures the new image is applied.
  exec bash -c "<%= $recreate_ops %>"
fi
exit 0
